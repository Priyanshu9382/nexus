// Prisma v8 Contract (Models only)

model User {
  id            String    @id @default(uuid())
  username      String    @unique
  email         String    @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now())
  
  // Relations
  conversations ConversationParticipant[]
  messages      Message[]
}

enum ConversationType {
  @@type("pg/text@1")
  DIRECT = "DIRECT"
  GROUP  = "GROUP"
}

model Conversation {
  id            String           @id @default(uuid())
  name          String?
  type          ConversationType @default(DIRECT)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @default(now())

  // Relations
  participants  ConversationParticipant[]
  messages      Message[]
}

model ConversationParticipant {
  id                     String   @id @default(uuid())
  userId                 String
  conversationId         String
  joinedAt               DateTime @default(now())
  
  // For tracking which messages the user has seen or received
  lastReadMessageId      String?
  lastDeliveredMessageId String?

  user                   User         @relation(fields: [userId], references: [id])
  conversation           Conversation @relation(fields: [conversationId], references: [id])

  // Constraints & Indexes
  @@unique([userId, conversationId])
  @@index([conversationId])
}

enum MessageType {
  @@type("pg/text@1")
  TEXT    = "TEXT"
  IMAGE   = "IMAGE"
  GIF     = "GIF"
  STICKER = "STICKER"
}

enum MessageStatus {
  @@type("pg/text@1")
  SENT      = "SENT"
  DELIVERED = "DELIVERED"
  READ      = "READ"
}

model Message {
  id             String        @id @default(uuid())
  // Client-generated temporary ID for idempotency and optimistic UI
  idempotencyKey String        @unique @map("tempId") 
  content        String?
  type           MessageType   @default(TEXT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now())
  
  // Simple status for individual message delivery/read states if needed
  status         MessageStatus @default(SENT)

  senderId       String
  conversationId String

  sender         User         @relation(fields: [senderId], references: [id])
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  attachments    Attachment[]

  // Critical index for efficient cursor-based message retrieval per conversation
  @@index([conversationId, createdAt])
}

model Attachment {
  id             String    @id @default(uuid())
  fileUrl        String
  fileType       String
  fileSize       Int
  createdAt      DateTime  @default(now())

  messageId      String
  message        Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}
